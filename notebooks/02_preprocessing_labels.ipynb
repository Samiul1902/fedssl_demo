    "# Cell 1 — Setup + dataset init (sanity check)\n",
    "\n",
    "from pathlib import Path\n",
    "import sys\n",
    "import torch\n",
    "\n",
    "# --- make sure project root is on sys.path ---\n",
    "cwd = Path.cwd()\n",
    "PROJECT_ROOT = cwd.parent if cwd.name.lower() == \"notebooks\" else cwd\n",
    "sys.path.insert(0, str(PROJECT_ROOT))\n",
    "\n",
    "print(\"CWD:\", cwd)\n",
    "print(\"PROJECT_ROOT:\", PROJECT_ROOT)\n",
    "print(\"src exists:\", (PROJECT_ROOT / \"src\").exists())\n",
    "\n",
    "# --- imports from your project ---\n",
    "from src.dataset import Kits2DSegDataset\n",
    "from src.transforms import TransformConfig, SegTransform\n",
    "\n",
    "# --- set dataset path (edit if needed) ---\n",
    "DATA_ROOT = Path(r\"F:\\projects\\hirdl\\FedSSL_Paper\\data_set\\kits_2d_splitted\")\n",
    "assert DATA_ROOT.exists(), f\"DATA_ROOT not found: {DATA_ROOT}\"\n",
    "\n",
    "# --- transforms ---\n",
    "cfg = TransformConfig(out_size=256, to_3ch=True, normalize_01=True)\n",
    "tfm = SegTransform(cfg)\n",
    "\n",
    "# --- datasets ---\n",
    "train_ds = Kits2DSegDataset(DATA_ROOT, \"train\", transform=tfm)\n",
    "val_ds   = Kits2DSegDataset(DATA_ROOT, \"val\", transform=tfm)\n",
    "\n",
    "print(\"train size:\", len(train_ds), \"val size:\", len(val_ds))\n",
    "\n",
    "# --- one sample ---\n",
    "x, y, meta = train_ds[0]\n",
    "print(\"image:\", x.shape, x.dtype, \"min/max:\", float(x.min()), float(x.max()))\n",
    "print(\"mask :\", y.shape, y.dtype, \"unique:\", torch.unique(y))\n",
    "print(\"meta filename:\", meta[\"filename\"])"
   ]
