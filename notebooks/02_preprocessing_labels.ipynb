   ],
   "source": [
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "\n",
    "def show_batch(xb, yb, k=6):\n",
    "    k = min(k, xb.size(0))\n",
    "    plt.figure(figsize=(12, 2.8*k))\n",
    "\n",
    "    for i in range(k):\n",
    "        img = xb[i].mean(dim=0).cpu().numpy()  # grayscale view from 3ch\n",
    "        msk = yb[i].cpu().numpy()\n",
    "        tumor = (msk == 2).astype(np.float32)\n",
    "\n",
    "        plt.subplot(k, 2, 2*i + 1)\n",
    "        plt.imshow(img, cmap=\"gray\")\n",
    "        plt.title(\"Image\")\n",
    "        plt.axis(\"off\")\n",
    "\n",
    "        plt.subplot(k, 2, 2*i + 2)\n",
    "        plt.imshow(img, cmap=\"gray\")\n",
    "        plt.imshow(tumor, alpha=0.35)\n",
    "        plt.title(\"Tumor overlay (class=2)\")\n",
    "        plt.axis(\"off\")\n",
    "\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "show_batch(xb, yb, k=6)"
   ]
