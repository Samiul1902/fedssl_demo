   "source": [
    "# Cell 2 — DataLoader test (batch) [fixed meta handling]\n",
    "\n",
    "from torch.utils.data import DataLoader\n",
    "import torch\n",
    "\n",
    "train_loader = DataLoader(\n",
    "    train_ds,\n",
    "    batch_size=8,\n",
    "    shuffle=True,\n",
    "    num_workers=2,      # if Windows multiprocessing issues happen, set 0\n",
    "    pin_memory=torch.cuda.is_available(),\n",
    ")\n",
    "\n",
    "xb, yb, meta = next(iter(train_loader))\n",
    "\n",
    "print(\"xb:\", xb.shape, xb.dtype, \"min/max:\", float(xb.min()), float(xb.max()))\n",
    "print(\"yb:\", yb.shape, yb.dtype)\n",
    "print(\"mask uniques in batch:\", torch.unique(yb))\n",
    "\n",
    "print(\"meta type:\", type(meta))\n",
    "# Most common: meta is a dict of lists after collate\n",
    "if isinstance(meta, dict):\n",
    "    print(\"meta keys:\", list(meta.keys()))\n",
    "    if \"filename\" in meta:\n",
    "        print(\"example filenames:\", meta[\"filename\"][:3])\n",
    "    else:\n",
    "        # fallback: print first key’s first 3 items\n",
    "        k0 = list(meta.keys())[0]\n",
    "        print(f\"example meta[{k0}]:\", meta[k0][:3])\n",
    "else:\n",
    "    # fallback if meta stays list-like\n",
    "    print(\"example filenames:\", [m[\"filename\"] for m in meta[:3]])"
   ]
